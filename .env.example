# WeatherAPI.com key. Get one at https://www.weatherapi.com/
# NEVER prefix this with NEXT_PUBLIC_ — it must stay server-side only.
WEATHER_API_KEY=

# Your final public URL (no trailing slash). Used for canonical URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=https://weathercatch.vercel.app
# Real inbox shown on the Contact page (builds trust with AdSense reviewers).
NEXT_PUBLIC_CONTACT_EMAIL=
# Contact form delivery (Resend)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
